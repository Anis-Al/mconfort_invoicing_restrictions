<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_invoicing_restrictions" model="ir.ui.view">
        <field name="name">account.move.form.invoicing.restrictions</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_draft']" position="attributes">
                <attribute name="groups">account.group_account_user</attribute>
            </xpath>
            <xpath expr="//div[@name='due_date']/field[@name='invoice_date_due']" position="before">
                <field name="invoicing_only_user" invisible="1"/>
            </xpath>
            <xpath expr="//div[@name='due_date']/field[@name='invoice_date_due']" position="attributes">
                <attribute name="readonly">invoicing_only_user and state == 'posted'</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_invoice_tree_invoicing_restrictions" model="ir.ui.view">
        <field name="name">account.move.list.invoicing.restrictions</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date_due']" position="before">
                <field name="invoicing_only_user" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='invoice_date_due']" position="attributes">
                <attribute name="readonly">invoicing_only_user and state == 'posted'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
